# Copy to /opt/erp/.env on the server (chmod 600) and fill in real values. Never commit the real file.
# Generate random secrets with:  openssl rand -base64 48

# Image tag to run; the deploy job rewrites this line on every release.
IMAGE_TAG=latest

# Hostnames (DNS A records must point at the server before the first start)
SITE_ADDRESS=flowbiterp.site, www.flowbiterp.site
ERP_ADDRESS=erp.flowbiterp.site

# Databases (internal to the compose network)
DB_PASSWORD=
DB_ROOT_PASSWORD=
REDIS_PASSWORD=

# JWT signing key: at least 32 characters
JWT_SECRET=

# SMTP (password-reset emails)
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_EMAIL=

# Aliyun OSS (file uploads)
OSS_ENDPOINT=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET_NAME=

# LLM (OpenAI-compatible API for the AI assistant)
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
